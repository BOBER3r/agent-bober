# Dependencies
node_modules/

# Build output
dist/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
*.pem

# OS files
.DS_Store
Thumbs.db

# Editor state
.vscode/
.idea/
*.swp
*.swo
*~

# Test and coverage
coverage/
.vitest/

# Runtime data
*.pid
*.seed
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Bober runtime state (managed per-project, not in the package itself)
.bober/snapshots/
.tokensave

# Personal data — never commit (repo has a public GitHub remote)
.bober/medical/
.bober/chat/

# Run record — never commit (same public-remote reason as the block above).
# `.bober/history.jsonl` is an append-only free-text log: every writer puts
# caller-supplied prose in it (feature requests, evaluator summaries, audit
# notes), and there is no bound on what a future writer may add. It is runtime
# state like `.bober/{scratch,traces,checkpoints,failures,logs}/` above, not a
# published artifact — nothing in src/ reads the committed copy (every consumer
# resolves it under its own `projectRoot`). `.archive.` is the rotated sibling
# produced by rotateIfNeeded once the active log passes maxActiveLines.
.bober/history.jsonl
.bober/history.archive.jsonl

# The ENGINE-generated progress document — runtime state, regenerated per run.
# The skill pipeline's curated `.bober/progress.md` is a different file with a
# different writer and STAYS TRACKED; see PROGRESS_FILE in src/state/history.ts.
# This one embeds `spec.description`, i.e. prose derived from the operator's
# feature request, so it is unpublished for the same reason the log is.
.bober/progress.generated.md

# Regenerable runtime state
.bober/memory/*.db
.bober/graph/.hook-queue.jsonl

# PGE graph-runtime state (sprint 6) — written per run, never version-controlled.
# Only the topology and golden-case artifacts stay tracked; a 40-node run would
# otherwise commit its scratch payloads, per-node archives, spans and cache entries.
.bober/scratch/
.bober/traces/
.bober/cache/
.bober/archive/
.bober/logs/

# Resumable run checkpoints (sprint 8) — one JSON snapshot per superstep. A 40-node
# run leaves ~40 of them, and they carry the whole run state; they are recovery
# artifacts, not committed ones.
.bober/checkpoints/

# Graceful-failure artifacts (sprint 9) — one per run that exhausted a branch's retries.
.bober/failures/

# Engram phase digests (sprint 10) — regenerated per phase on every run. This is the
# SINGULAR directory owned by the graph runtime; the tracked plural `.bober/handoffs/`
# holds the skill-driven pipeline's ContextHandoff documents and stays version-controlled.
.bober/handoff/
