# Dependencies
node_modules/

# Build output
dist/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
*.pem

# OS files
.DS_Store
Thumbs.db

# Editor state
.vscode/
.idea/
*.swp
*.swo
*~

# Test and coverage
coverage/
.vitest/

# Runtime data
*.pid
*.seed
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Bober runtime state (managed per-project, not in the package itself)
.bober/snapshots/
.tokensave

# Personal data — never commit (repo has a public GitHub remote)
.bober/medical/
.bober/chat/

# Regenerable runtime state
.bober/memory/*.db
.bober/graph/.hook-queue.jsonl

# PGE graph-runtime state (sprint 6) — written per run, never version-controlled.
# Only the topology and golden-case artifacts stay tracked; a 40-node run would
# otherwise commit its scratch payloads, per-node archives, spans and cache entries.
.bober/scratch/
.bober/traces/
.bober/cache/
.bober/archive/
.bober/logs/

# Resumable run checkpoints (sprint 8) — one JSON snapshot per superstep. A 40-node
# run leaves ~40 of them, and they carry the whole run state; they are recovery
# artifacts, not committed ones.
.bober/checkpoints/
